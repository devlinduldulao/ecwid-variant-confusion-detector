# NOTE: This file is used by Netlify / Cloudflare Pages only.
# GitHub Pages ignores it. For GitHub Pages, CSP and Referrer-Policy
# are enforced via <meta> tags in each HTML file. HSTS is provided
# by GitHub for *.github.io domains automatically.
# Keep this file so the app works if migrated to Netlify/Cloudflare.
/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' https://djqizrxa6f10j.cloudfront.net; style-src 'self' https://djqizrxa6f10j.cloudfront.net; connect-src 'self' https://app.ecwid.com; img-src 'self' data: blob:; font-src 'self'; frame-ancestors https://my.ecwid.com https://*.ecwid.com https://*.lightspeed.com